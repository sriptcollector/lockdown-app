{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lockdown",
  "version": "0.2.10",
  "identifier": "ai.westwardconsulting.lockdown",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Lockdown", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 640, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "externalBin": ["binaries/lockdown-engine"],
    "publisher": "Westward",
    "homepage": "https://westwardconsulting.ai/products/lockdown",
    "category": "Utility",
    "shortDescription": "Find every way in, then fix it",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" }
  }
}
